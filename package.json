{
  "name": "jidian",
  "version": "1.0.1",
  "main": "electron/main.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "serve": "NODE_ENV=production tsx server/index.ts",
    "desktop:dev": "concurrently -k -n server,vite,electron -c yellow,blue,green \"cross-env PORT=4173 NODE_ENV=development APP_RUNTIME=desktop tsx server/index.ts\" \"vite --host 127.0.0.1 --strictPort\" \"wait-on tcp:127.0.0.1:4173 tcp:127.0.0.1:5173 && cross-env NODE_ENV=development APP_RUNTIME=desktop JIDIAN_API_ORIGIN=http://127.0.0.1:4173 electron .\"",
    "desktop:build": "node electron/build-desktop.js --mac zip dmg --arm64",
    "desktop:build:dir": "node electron/build-desktop.js --dir --arm64",
    "desktop:build:universal": "node electron/build-desktop.js --mac zip dmg --universal",
    "desktop:build:x64": "node electron/build-desktop.js --mac zip dmg --x64",
    "desktop:build:dir:x64": "node electron/build-desktop.js --dir --x64",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "check:public": "node scripts/check-public-files.mjs",
    "check": "npm run typecheck && vite build"
  },
  "keywords": [
    "portfolio",
    "fund",
    "stock",
    "dca",
    "electron",
    "local-first"
  ],
  "author": "Veeja Liu",
  "license": "ISC",
  "description": "基点 Jidian — 本地优先的基金与 A 股投资记录工具，支持多账户、持仓收益分析、分红管理与定投辅助。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeejaLiu/jidian.git"
  },
  "homepage": "https://github.com/VeejaLiu/jidian#readme",
  "bugs": {
    "url": "https://github.com/VeejaLiu/jidian/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "pinyin-pro": "^3.28.1",
    "react": "^19.2.7",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wait-on": "^8.0.5"
  }
}
